{
  "name": "claude-ready",
  "version": "0.1.0",
  "description": "Type one command. Start building with AI.",
  "type": "module",
  "bin": {
    "claude-ready": "./dist/index.js"
  },
  "files": ["dist/*.js", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "setup",
    "cli",
    "developer-tools",
    "anthropic"
  ],
  "license": "MIT",
  "author": "naotoshima",
  "repository": {
    "type": "git",
    "url": "https://github.com/isle-and-roots/claude-ready.git"
  },
  "homepage": "https://github.com/isle-and-roots/claude-ready#readme",
  "bugs": {
    "url": "https://github.com/isle-and-roots/claude-ready/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1",
    "@claude-ready/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
